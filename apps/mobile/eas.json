{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "screenshots": {
      "environment": "preview",
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_DISABLE_XCODE_DEBUG_UPLOAD": "true",
        "SENTRY_ALLOW_FAILURE": "true",
        "SENTRY_CLI_EXECUTABLE": "/usr/bin/true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "lalit.nv@gmail.com",
        "ascAppId": "6759380856",
        "appleTeamId": "2R7B423ZQV"
      },
      "android": {
        "applicationId": "com.lallimaven.eclipsetimer",
        "track": "internal"
      }
    }
  }
}
