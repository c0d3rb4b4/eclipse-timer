{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "screenshots": {
      "environment": "preview",
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_DISABLE_XCODE_DEBUG_UPLOAD": "true",
        "SENTRY_ALLOW_FAILURE": "true",
        "SENTRY_CLI_EXECUTABLE": "/usr/bin/true"
      }
    },
    "production-apk": {
      "extends": "production",
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      }
    },
    "production-wear": {
      "extends": "production",
      "autoIncrement": false,
      "android": {
        "gradleCommand": ":wear:bundleRelease",
        "applicationArchivePath": "android/wear/build/outputs/bundle/release/wear-release.aab"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6759380856",
        "appleTeamId": "2R7B423ZQV"
      },
      "android": {
        "applicationId": "com.lallimaven.eclipsetimer",
        "track": "internal"
      }
    }
  }
}
